#!/bin/sh
# Thin POSIX wrapper; the logic lives in obd.py (stdlib only). Uses any Python 3.8+, else uv (which fetches its own Python).
D="$(cd "$(dirname "$0")" && pwd)"
for p in python3 python py; do
  # the probe skips the Windows Store "python3" stub, which exists on PATH but is not a Python
  if command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
    exec "$p" "$D/obd.py" "$@"
  fi
done
find_uv() {
  U="$(command -v uv 2>/dev/null)"
  for c in "$HOME/.local/bin/uv" "$HOME/.local/bin/uv.exe"; do [ -z "$U" ] && [ -x "$c" ] && U="$c"; done
}
find_uv
if [ -z "$U" ] && [ "$1" = setup ]; then
  case " $* " in *" --install-uv "*)   # no Python to run obd.py yet, so the wrapper installs uv itself
    case "$(uname -s)" in
      MINGW*|MSYS*|CYGWIN*) powershell -NoProfile -ExecutionPolicy Bypass -Command "irm https://astral.sh/uv/install.ps1 | iex" >&2 ;;
      *) curl -LsSf https://astral.sh/uv/install.sh | sh >&2 ;;
    esac
    find_uv ;;
  esac
fi
[ -n "$U" ] && exec "$U" run --no-project --python 3.12 "$D/obd.py" "$@"
CODE=SETUP_REQUIRED; [ "$1" = setup ] && CODE=NEEDS_UV
echo '{"status":"error","summary":"The engine is not set up. Run /obd setup.","error":{"code":"'$CODE'","message":"Neither Python 3 nor uv was found.","hint":"Run /obd setup; it installs uv (from astral.sh) after asking you."}}'
exit 4
